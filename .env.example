# StayEase Environment Variable Configurations Template
# Copy this file locally as '.env' and fill in your actual production/test credentials.

# Supabase Connection Keys (From your Supabase Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-actual-anon-public-api-key-string

# Razorpay Checkout Gateway Keys (From your Razorpay Dashboard -> Settings -> API Keys)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_here
